# GEMINI_API_KEY: Optional server-side Gemini API Free Tier key.
# Not required in Free Development Mode (AI_PROVIDER=mock).
# Add via AI Studio Secrets only when activating gemini_free; never expose in frontend code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional comma-separated list of verified emails allowed server-side admin bootstrap
PLATFORM_ADMIN_EMAILS=""

# Central AI Gateway Configuration (Free Development Mode by default)
# Allowed values: mock | gemini_free | ollama_local | gemini_paid (requires AI_PAID_ENABLED=true)
AI_PROVIDER="mock"
AI_PAID_ENABLED="false"

# Optional Gemini Free Tier model & allowlist subset
# Only models approved by the server-side trusted free-model policy can be used.
# Adding unverified or paid-only model names here will NOT bypass server policy.
AI_GEMINI_FREE_MODEL="gemini-3.1-flash-lite"
AI_GEMINI_FREE_ALLOWLIST="gemini-3.1-flash-lite"

# Optional Local Ollama configuration (for local computer development only; blocked on localhost in Cloud Run)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# Phase 2 Runtime Mapping & Location Provider Configuration (switchable without rebuild)
# LOCATION_SEARCH_PROVIDER: osm_nominatim | gazetteer_only | custom_http
LOCATION_SEARCH_PROVIDER="osm_nominatim"
CUSTOM_GEOCODER_URL=""
MAP_STREET_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# Set MAP_SATELLITE_ENABLED=true only with appropriate Esri/commercial licensing
MAP_SATELLITE_ENABLED="false"
MAP_SATELLITE_TILE_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"

# Production Server & PostgreSQL Configuration (Render / Local)
PORT="3000"
NODE_ENV="development"
# Option 1 (Render / Managed PostgreSQL): Full connection string (remote hosts use verified TLS by default)
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Option 2 (Local / Cloud SQL socket): Discrete connection settings
# SQL_HOST="localhost"
# SQL_PORT="5432"
# SQL_USER="postgres"
# SQL_PASSWORD=""
# SQL_DB_NAME="field_fussion"
# Optional TLS controls (certificate verification is always enforced in production)
# SQL_SSL="true"
# SQL_SSL_CA=""
# SQL_SSL_CA_FILE=""
